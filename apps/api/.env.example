# .env.example — copy to .env and fill in real values before running.
# NEVER commit .env or real secrets to Git.

# Application
APP_ENV=development
APP_NAME=upbhokta-setu-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1
PORT=8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# CORS — comma-separated origins for local development
CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19006

# Logging
LOG_LEVEL=info
